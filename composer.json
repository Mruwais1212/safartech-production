{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "carlos-meneses/laravel-mpdf": "^2.1",
        "khaled.alshamaa/ar-php": "^6.3",
        "kreait/firebase-php": "^7.10",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "^3.1",
        "mcamara/laravel-localization": "^2.0",
        "mfrouh/activity-model": "^2.2",
        "mfrouh/check-missing-translations": "^1.6",
        "mfrouh/scope-statistics": "^1.6",
        "muktar-sayedsaleh/zakat-tlv-generator": "^0.2.0",
        "rap2hpoutre/laravel-log-viewer": "^2.4",
        "rmunate/spell-number": "^1.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "tymon/jwt-auth": "^2.1",
        "ixudra/curl": "^6.22"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13.5",
        "brianium/paratest": "^7.4",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.53",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.4",
        "squizlabs/php_codesniffer": "3.9.1",
        "tightenco/duster": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "php-md": [
            "./vendor/bin/phpmd app ansi phpmd.xml"
        ],
        "php-cs": [
            "./vendor/bin/phpcs --standard=psr2,psr12,ruleset.xml app"
        ],
        "php-cs-fixer": [
            "./vendor/bin/php-cs-fixer fix"
        ],
        "pint":[
            "./vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
